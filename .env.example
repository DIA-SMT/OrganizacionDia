NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional para futuras notificaciones/chat
RESEND_API_KEY=
OPENROUTER_API_KEY=

# GitHub privado para sincronizar proyectos/repos
GITHUB_ORG=DIA-SMT
GITHUB_TOKEN=
# Alta automatica de repos nuevos como proyectos (supabase/add_project_github_sync.sql).
# El mismo secreto va en GitHub Actions (secrets.PROJECTS_SYNC_SECRET) para el cron.
PROJECTS_SYNC_SECRET=
# Repos que no son proyectos, separados por coma (ej: pruebas,plantilla)
GITHUB_SYNC_IGNORE=

# Google Drive: Service Account con acceso lector a la carpeta de expedientes
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_EXPEDIENTES_FOLDER_ID=
DRIVE_SYNC_SECRET=
EXPEDIENTES_OCR_MAX_PAGES=5
EXPEDIENTES_OCR_MAX_MB=15

# Alexa: solo servidor, nunca usar NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ALEXA_API_SECRET=
ALEXA_ALLOWED_USER_IDS=
